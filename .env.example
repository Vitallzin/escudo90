APP_NAME=Escudo Noventa API
NODE_ENV=development
PORT=3333

APP_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3333

# Use um segredo longo em producao. Nunca compartilhe o valor real.
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Banco de dados principal.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/loja_camisas

# Supabase. Use valores reais somente no arquivo .env local/servidor.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui

# Apenas backend. Nunca envie essa chave para o frontend.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
